{% doc %}
  @prompt
    Create a "Limited Edition Stock Counter" block for the product page that allows merchants to manually enter a number representing how many units are left (e.g., "Only 12 left"), and displays a styled low-stock message or counter badge on the product page. The display should be visually prominent, fitting a premium gallery-style aesthetic, and should not rely on Shopify's automatic inventory — it's a manually set number stored as a block setting. Include options to customize the label text (e.g., "Only X left", "Limited to X pieces") and optionally show/hide the counter.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-stock-counter-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-stock-counter__wrapper-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    background-color: {{ block.settings.background_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    font-family: {{ block.settings.font.family }}, {{ block.settings.font.fallback_families }};
    font-weight: {{ block.settings.font.weight }};
    font-style: {{ block.settings.font.style }};
  }

  .ai-stock-counter__icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-stock-counter__icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    stroke: {{ block.settings.icon_color }};
  }

  .ai-stock-counter__text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    line-height: 1.4;
  }

  .ai-stock-counter__number-{{ ai_gen_id }} {
    color: {{ block.settings.number_color }};
    font-weight: {{ block.settings.number_weight }};
  }

  @media screen and (max-width: 749px) {
    .ai-stock-counter-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-stock-counter__wrapper-{{ ai_gen_id }} {
      padding: 12px 16px;
    }

    .ai-stock-counter__text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

{% if block.settings.show_counter %}
  <div class="ai-stock-counter-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-stock-counter__wrapper-{{ ai_gen_id }}">
      {% if block.settings.show_icon %}
        <div class="ai-stock-counter__icon-{{ ai_gen_id }}">
          {% if block.settings.icon_style == 'alert' %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          {% elsif block.settings.icon_style == 'clock' %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          {% elsif block.settings.icon_style == 'flame' %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"></path>
            </svg>
          {% else %}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          {% endif %}
        </div>
      {% endif %}

      <div class="ai-stock-counter__text-{{ ai_gen_id }}">
        {% if block.settings.label_format == 'only_x_left' %}
          Only <span class="ai-stock-counter__number-{{ ai_gen_id }}">{{ block.settings.stock_count }}</span> left
        {% elsif block.settings.label_format == 'limited_to_x' %}
          Limited to <span class="ai-stock-counter__number-{{ ai_gen_id }}">{{ block.settings.stock_count }}</span> pieces
        {% elsif block.settings.label_format == 'x_remaining' %}
          <span class="ai-stock-counter__number-{{ ai_gen_id }}">{{ block.settings.stock_count }}</span> remaining
        {% elsif block.settings.label_format == 'x_in_stock' %}
          <span class="ai-stock-counter__number-{{ ai_gen_id }}">{{ block.settings.stock_count }}</span> in stock
        {% else %}
          {{ block.settings.custom_label | replace: '[count]', block.settings.stock_count }}
        {% endif %}
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Limited stock counter",
  "settings": [
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_counter",
      "label": "Show counter",
      "default": true
    },
    {
      "type": "header",
      "content": "Stock count"
    },
    {
      "type": "range",
      "id": "stock_count",
      "label": "Units remaining",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "label_format",
      "label": "Label format",
      "options": [
        {
          "value": "only_x_left",
          "label": "Only X left"
        },
        {
          "value": "limited_to_x",
          "label": "Limited to X pieces"
        },
        {
          "value": "x_remaining",
          "label": "X remaining"
        },
        {
          "value": "x_in_stock",
          "label": "X in stock"
        },
        {
          "value": "custom",
          "label": "Custom label"
        }
      ],
      "default": "only_x_left"
    },
    {
      "type": "text",
      "id": "custom_label",
      "label": "Custom label",
      "info": "Use [count] as placeholder for the number. Example: 'Just [count] available'",
      "default": "Just [count] available"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": true
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Icon style",
      "options": [
        {
          "value": "alert",
          "label": "Alert triangle"
        },
        {
          "value": "info",
          "label": "Info circle"
        },
        {
          "value": "clock",
          "label": "Clock"
        },
        {
          "value": "flame",
          "label": "Flame"
        }
      ],
      "default": "alert"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 16,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#C6FF3D"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "font",
      "label": "Font",
      "default": "inter_n4"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F4EFE6"
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number color",
      "default": "#C6FF3D"
    },
    {
      "type": "select",
      "id": "number_weight",
      "label": "Number weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semibold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "600"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#17181B"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#2A2B2F"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Limited stock counter"
    }
  ]
}
{% endschema %}
